# Cloud test configuration. For Docker, use .env.local.example and npm run local:setup.
# Copy manually to .env.local and provide credentials for your test environment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Clerk development instance keys; authentication remains hosted by Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_OPERATOR_NAME=Prototype portal operator
NEXT_PUBLIC_SUPPORT_EMAIL=

# Private Backblaze B2 bucket; keep credentials server-only.
# Endpoint e.g. https://s3.us-west-004.backblazeb2.com; region must match.
# Use a bucket-scoped application key with readFiles/writeFiles capabilities.
# File requests always check claim access; direct browser upload CORS is not needed.
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
B2_FORCE_PATH_STYLE=false

# Local synthetic preview only. Never enabled by the application in production.
PORTAL_DEMO_ENABLED=false

# Clerk sends invitations and authentication emails. Set Access mode to Invite-only.
# One explicitly selected first admin (Clerk user ID, not an email); remove after setup.
PORTAL_BOOTSTRAP_CLERK_USER_ID=
