# Copy manually to .env.local and provide credentials for your test environment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_OPERATOR_NAME=Prototype portal operator
NEXT_PUBLIC_SUPPORT_EMAIL=

# disabled (safe default), sandbox (test inbox only), or live (recipient delivery).
PORTAL_EMAIL_MODE=disabled
PORTAL_EMAIL_FROM=portal@example.test
PORTAL_EMAIL_FROM_NAME=Insurance Portal
MAILTRAP_API_KEY=
MAILTRAP_TEST_INBOX_ID=

# Private Backblaze B2 test bucket. File requests always check claim access.
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=

# Local synthetic preview only. Never enabled by the application in production.
PORTAL_DEMO_ENABLED=false
