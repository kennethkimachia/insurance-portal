# Used by npm run local:* and Next.js. These credentials are local test values.
# Keep this file in sync with compose.yaml; do not put cloud DB/storage URLs here.
LOCAL_POSTGRES_PORT=5433
LOCAL_S3_PORT=8333
DATABASE_URL=postgresql://portal:portal_local_password@127.0.0.1:5433/insurance_portal

# SeaweedFS provides the S3 API used by the Backblaze client.
B2_ENDPOINT=http://127.0.0.1:8333
B2_REGION=us-east-1
B2_KEY_ID=portal-local
B2_APP_KEY=portal-local-secret
B2_BUCKET_NAME=portal-evidence-local
B2_FORCE_PATH_STYLE=true

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_OPERATOR_NAME=Local insurance portal
NEXT_PUBLIC_SUPPORT_EMAIL=
PORTAL_DEMO_ENABLED=true

# Authentication still uses Clerk. Add keys from a DEVELOPMENT instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk sends invitations and authentication emails. Set Access mode to Invite-only.
# One explicitly selected first admin (Clerk user ID, not an email); remove after setup.
PORTAL_BOOTSTRAP_CLERK_USER_ID=
